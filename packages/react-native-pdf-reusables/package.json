{
  "name": "react-native-pdf-reusables",
  "version": "0.1.0",
  "description": "Source-owned PDF components for React Native and Expo",
  "license": "MIT",
  "type": "module",
  "bin": {
    "react-native-pdf-reusables": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "expo-print": "*",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "expo-print": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "react": "19.2.3"
  }
}
